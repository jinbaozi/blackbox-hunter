{
  "version": 1,
  "base_contract": "prompts/track_b/base_contract.md",
  "evidence_wrapper": "prompts/track_b/evidence_wrapper.md",
  "output_contract": "prompts/track_b/output_contract.md",
  "core_dimensions": [
