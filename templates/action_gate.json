{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox-hunter/schemas/action_gate.json",
  "title": "Action Gate Evaluation",
  "type": "object",
  "required": ["request", "decision"],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": ["action_type", "phase", "command", "requires_network", "writes_outside_results", "runs_target_code", "privileged", "in_sandbox", "user_approved"],
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": ["string", "null"]},
        "action_type": {"type": "string", "enum": ["run_poc", "run_target", "execute_command", "install_tool", "pull_image", "package_manager", "read_artifact", "write_artifact"]},
        "phase": {"type": "string"},
        "finding_id": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null]},
        "command": {"type": "array", "items": {"type": "string"}},
        "requires_network": {"type": "boolean"},
        "writes_outside_results": {"type": "boolean"},
        "runs_target_code": {"type": "boolean"},
        "privileged": {"type": "boolean"},
        "in_sandbox": {"type": "boolean"},
        "user_approved": {"type": "boolean"},
        "approval_reason": {"type": ["string", "null"]}
      }
    },
    "decision": {
      "type": "object",
      "required": ["allowed", "reason", "blocked_rules"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "boolean"},
        "reason": {"type": "string"},
        "blocked_rules": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
