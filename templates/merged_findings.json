{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox-hunter/schemas/merged_findings.json",
  "title": "Merged Findings",
  "type": "object",
  "required": [
    "merged_findings",
    "dedup_stats",
    "confidence_scores",
    "coverage_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "merged_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "dedup_info"
        ],
        "additionalProperties": false,
        "properties": {
          "finding": {
            "$ref": "finding.json"
          },
          "dedup_info": {
            "type": "object",
            "required": [
              "merged_from",
              "rule"
            ],
            "additionalProperties": false,
            "properties": {
              "merged_from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rule": {
                "type": "string"
              },
              "signal_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dedup_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence_scores": {
      "type": "object",
      "description": "Map finding_id to structured confidence components.",
      "additionalProperties": {
        "$ref": "confidence_breakdown.json"
      }
    },
    "lifecycle_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
