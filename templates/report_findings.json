{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox-hunter/schemas/report_findings.json",
  "title": "Report Findings",
  "type": "object",
  "required": ["schema_version", "scan_id", "findings", "summary", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scan_id": {
      "type": "string",
      "pattern": "^BBH-[0-9]{8}-[a-z0-9]{6}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.json"
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "by_status"],
      "additionalProperties": true,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
