{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox-hunter/schemas/env_check.json",
  "title": "Environment Check Report",
  "type": "object",
  "required": ["checked_at", "path_patched", "path_warnings", "tools", "block_decision"],
  "additionalProperties": false,
  "properties": {
    "checked_at": {"type": "string", "format": "date-time"},
    "path_patched": {"type": "boolean"},
    "path_warnings": {"type": "array", "items": {"type": "string"}},
    "extended_dirs_scanned": {"type": "array", "items": {"type": "string"}},
    "offline_mode": {"type": "boolean"},
    "check_only": {"type": "boolean"},
    "package_manager": {"type": "string", "enum": ["unknown", "apt", "dnf", "microdnf", "yum", "zypper", "rpm-ostree", "brew"]},
    "registry_path": {"type": "string"},
    "output_path": {"type": "string"},
    "package_type": {"type": "string", "enum": ["", "deb", "rpm"]},
    "rootfs_status": {
      "type": "string",
      "enum": ["imported", "stale", "not_imported", "lfs_pointer", "missing"]
    },
    "imported_image_ref": {"type": ["string", "null"]},
    "engine_status": {
      "type": "string",
      "enum": ["ready", "ready_podman", "unavailable"]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "priority", "status"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "binary_name": {"type": "string"},
          "execution_model": {"type": "string", "enum": ["host_binary", "container_image"]},
          "container_engine": {"type": "string"},
          "container_image": {"type": "string"},
          "priority": {"type": "string", "enum": ["required", "required_verify", "high", "medium", "optional"]},
          "status": {"type": "string", "enum": ["available", "missing", "version_low", "install_failed", "fallback_active", "skipped_not_applicable"]},
          "detected_version": {"type": "string"},
          "required_version": {"type": "string"},
          "found_in": {"type": "string"},
          "install_method": {"type": "string"},
          "fallback_used": {"type": "string"},
          "error_message": {"type": "string"},
          "applicable": {"type": "boolean"}
        }
      }
    },
    "block_decision": {
      "type": "object",
      "required": ["blocked"],
      "additionalProperties": false,
      "properties": {
        "blocked": {"type": "boolean"},
        "reason": {"type": "string"},
        "blocked_tools": {"type": "array", "items": {"type": "string"}},
        "install_hints": {"type": "array", "items": {"type": "string"}},
        "phase_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "tool", "reason"],
            "additionalProperties": false,
            "properties": {
              "phase": {"type": "string"},
              "tool": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence_ceiling": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
